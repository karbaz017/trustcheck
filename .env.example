# Server
PORT=8787
APP_ORIGIN=http://localhost:5173
# Leave DATABASE_URL empty to use the in-memory store (fine for local dev)
DATABASE_URL=

# Gemini on Vertex AI (required). Auth is Application Default Credentials, no API key:
#   gcloud auth application-default login      (local dev)
#   or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   (servers)
# The account needs the "Vertex AI User" role and the Vertex AI API enabled on the project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Search: Gemini on Vertex AI with Google Search grounding (same credentials; model must support grounding)
# Comma-separated, in fallback order. Options: gemini, tavily, brave
SEARCH_PROVIDERS=gemini
# Only needed if you add them to SEARCH_PROVIDERS
TAVILY_API_KEY=
BRAVE_API_KEY=

# Auth0 (optional; anonymous checks work without it)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Add-on feature flags (default off; anything other than "true" or "1" is off)
FEATURE_CALCULATORS=false
FEATURE_EMAIL_CHECK=false

FEATURE_SCAMSOS=false
FEATURE_MARKET=false

# Live data tools (default off). Crypto prices need no key. Each other tool turns on when its setting is present.
FEATURE_LIVE_DATA=false
FINNHUB_API_KEY=
# SEC asks automated clients to identify themselves, e.g. "TrustCheck HackPSU your-email@example.com"
SEC_USER_AGENT=
